PORT=3000
DEMO_PIN=1234
TRANSLATION_PROVIDER=mock

# Set TRANSLATION_PROVIDER=openai after adding your key to .env.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-realtime-translate
MAX_SESSION_SECONDS=300
# Optional source transcript costs extra; translated subtitles are always enabled.
OPENAI_SOURCE_TRANSCRIPTION=false

# Alternative Groq mode:
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AUDIO_CHUNK_MS=2500

# Public test hosting: use a unique access code of at least 8 characters.
# Render generates DEMO_PIN automatically.
MAX_CONCURRENT_SESSIONS=2
# Aggregate audio seconds since server start; resets on restart. Not an account spending cap.
MAX_TOTAL_AUDIO_SECONDS=3600
